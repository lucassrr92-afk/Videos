# --- IA (escolha dos melhores momentos, títulos e legendas dos posts) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Transcrição (faster-whisper): tiny | base | small | medium | large-v3 ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto          # auto | cpu | cuda
WHISPER_LANGUAGE=            # vazio = detectar automaticamente (ex.: pt)

# --- Servidor ---
PUBLIC_BASE_URL=http://localhost:8000   # usado nos redirects OAuth

# --- YouTube Shorts (Google Cloud: YouTube Data API v3, OAuth "Web application") ---
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_PRIVACY=public       # public | unlisted | private

# --- TikTok (developers.tiktok.com: Content Posting API, escopo video.publish) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE  # apps não auditados só podem usar SELF_ONLY

# --- Instagram Reels (Meta: conta Business/Creator ligada a uma Página) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0
